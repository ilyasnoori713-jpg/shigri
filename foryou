    <!-- JAVASCRIPT APPLICATION CORE -->
    <script>
        /**
         * CANTEEN KHATA PWA APPLICATION LOGIC
         * - Clean IndexedDB Store initialization & operations
         * - Persistent local ledger calculation
         */

        const DB_NAME = 'CanteenKhataDB';
        const DB_VERSION = 1;
        let db = null;

        // Default products specification
        const DEFAULT_PRODUCTS = [
            { id: 'PROD-101', name: 'Banana Shake', sizes: { Medium: 100, Large: 150 } },
            { id: 'PROD-102', name: 'Banana with Dates Shake', sizes: { Medium: 150, Large: 200 } },
            { id: 'PROD-103', name: 'Dates Shake', sizes: { Medium: 200, Large: 250 } },
            { id: 'PROD-104', name: 'Dahi Baray', sizes: { Medium: 100, Large: 150 } }
        ];

        // Global State Cache
        let state = {
            customers: [],
            products: [],
            orders: []
        };

        // Initialize Database on Page Load
        window.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('currentDateDisplay').innerText = new Date().toLocaleDateString('en-US', {
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
            });
            
            try {
                await initIndexedDB();
                await reloadAllData();
                setupPWA();
            } catch (err) {
                showToast('Failed to initialize local database.', 'error');
                console.error(err);
            }
        });

        /* ================= IndexedDB Engine ================= */
        function initIndexedDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_NAME, DB_VERSION);

                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains('customers')) {
                        db.createObjectStore('customers', { keyPath: 'id' });
                    }
                    if (!db.objectStoreNames.contains('products')) {
                        db.createObjectStore('products', { keyPath: 'id' });
                    }
                    if (!db.objectStoreNames.contains('orders')) {
                        db.createObjectStore('orders', { keyPath: 'id' });
                    }
                };

                request.onsuccess = (event) => {
                    db = event.target.result;
                    resolve(db);
                };

                request.onerror = (event) => {
                    reject(event.target.error);
                };
            });
        }

        // Generic IndexedDB Transactions
        function dbGetAll(storeName) {
            return new Promise((resolve, reject) => {
                const tx = db.transaction(storeName, 'readonly');
                const store = tx.objectStore(storeName);
                const req = store.getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => reject(req.error);
            });
        }

        function dbPut(storeName, data) {
            return new Promise((resolve, reject) => {
                const tx = db.transaction(storeName, 'readwrite');
                const store = tx.objectStore(storeName);
                const req = store.put(data);
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);
            });
        }

        function dbDelete(storeName, id) {
            return new Promise((resolve, reject) => {
                const tx = db.transaction(storeName, 'readwrite');
                const store = tx.objectStore(storeName);
                const req = store.delete(id);
                req.onsuccess = () => resolve();
                req.onerror = () => reject(req.error);
            });
        }

        // Load or initialize DB state
        async function reloadAllData() {
            state.customers = await dbGetAll('customers');
            state.products = await dbGetAll('products');
            state.orders = await dbGetAll('orders');

            // Seed default products if empty
            if (state.products.length === 0) {
                for (const p of DEFAULT_PRODUCTS) {
                    await dbPut('products', p);
                }
                state.products = await dbGetAll('products');
            }

            renderCurrentTab();
        }

        /* ================= Navigation ================= */
        let activeTab = 'dashboard';

        function switchTab(tabId) {
            activeTab = tabId;
            
            // Hide all tabs
            ['dashboard', 'orders', 'customers', 'products', 'backup'].forEach(tab => {
                document.getElementById(`tab-${tab}-view`).classList.add('hidden');
                
                const desktopNav = document.getElementById(`nav-${tab}`);
                if(desktopNav) desktopNav.classList.remove('active');
                
                const mobileNav = document.getElementById(`mobile-nav-${tab}`);
                if(mobileNav) mobileNav.classList.remove('active');
            });

            // Show selected tab
            document.getElementById(`tab-${tabId}-view`).classList.remove('hidden');
            const activeDesktop = document.getElementById(`nav-${tabId}`);
            if(activeDesktop) activeDesktop.classList.add('active');
            
            const activeMobile = document.getElementById(`mobile-nav-${tabId}`);
            if(activeMobile) activeMobile.classList.add('active');

            renderCurrentTab();
        }

        function renderCurrentTab() {
            if (activeTab === 'dashboard') loadDashboardData();
            if (activeTab === 'orders') renderOrdersTable();
            if (activeTab === 'customers') renderCustomersList();
            if (activeTab === 'products') renderProductsGrid();
        }

        /* ================= 1. Dashboard Logic ================= */
        function loadDashboardData() {
            const todayStr = new Date().toISOString().split('T')[0];

            let todaySales = 0;
            let totalPaid = 0;
            let totalUnpaid = 0;

            state.orders.forEach(order => {
                const orderAmount = Number(order.totalAmount || 0);
                
                // Calculate today sales
                if (order.date && order.date.startsWith(todayStr)) {
                    todaySales += orderAmount;
                }

                if (order.paymentStatus === 'Paid') {
                    totalPaid += orderAmount;
                } else {
                    totalUnpaid += orderAmount;
                }
            });

            document.getElementById('dashTodaySales').innerText = `Rs. ${todaySales.toLocaleString()}`;
            document.getElementById('dashTotalOrders').innerText = state.orders.length;
            document.getElementById('dashTotalCustomers').innerText = state.customers.length;
            document.getElementById('dashTotalPaid').innerText = `Rs. ${totalPaid.toLocaleString()}`;
            document.getElementById('dashTotalUnpaid').innerText = `Rs. ${totalUnpaid.toLocaleString()}`;
            document.getElementById('dashRemainingBalance').innerText = `Rs. ${totalUnpaid.toLocaleString()}`;

            // Render Recent 5 Orders
            const sortedOrders = [...state.orders].sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)).slice(0, 5);
            const tbody = document.getElementById('dashRecentOrdersTable');
            
            if (sortedOrders.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-4 text-center text-gray-400">No orders placed yet.</td></tr>`;
                return;
            }

            tbody.innerHTML = sortedOrders.map(o => {
                const isPaid = o.paymentStatus === 'Paid';
                return `
                    <tr class="hover:bg-gray-50/50">
                        <td class="py-2.5 px-3 font-mono font-bold text-xs text-canteen-800">${o.id}</td>
                        <td class="py-2.5 px-3 font-semibold text-gray-800">${escapeHtml(o.customerName)}</td>
                        <td class="py-2.5 px-3">${escapeHtml(o.productName)} (${o.size}) × ${o.quantity}</td>
                        <td class="py-2.5 px-3 font-bold">Rs. ${o.totalAmount}</td>
                        <td class="py-2.5 px-3">
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full ${isPaid ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                                ${o.paymentStatus}
                            </span>
                        </td>
                        <td class="py-2.5 px-3">
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full ${o.deliveryStatus === 'Delivered' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-700'}">
                                ${o.deliveryStatus}
                            </span>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            <button onclick="toggleQuickPaymentStatus('${o.id}')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-2.5 py-1 rounded-lg font-medium transition">
                                Toggle Payment
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function toggleQuickPaymentStatus(orderId) {
            const order = state.orders.find(o => o.id === orderId);
            if (!order) return;
            order.paymentStatus = order.paymentStatus === 'Paid' ? 'Unpaid' : 'Paid';
            await dbPut('orders', order);
            await reloadAllData();
            showToast(`Order ${orderId} marked as ${order.paymentStatus}`);
        }

        /* ================= 2. Customer Management & Ledger Account ================= */
        function openAddCustomerModal(fromOrder = false) {
            document.getElementById('customerForm').reset();
            document.getElementById('customerEditId').value = '';
            document.getElementById('customerFormFromOrder').value = fromOrder ? 'true' : 'false';
            document.getElementById('customerModalTitle').innerText = 'Add New Customer';
            document.getElementById('customerModal').classList.remove('hidden');
        }

        async function saveCustomer(e) {
            e.preventDefault();
            const editId = document.getElementById('customerEditId').value;
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();
            const fromOrder = document.getElementById('customerFormFromOrder').value === 'true';

            if (!name) return;

            // Check duplicates
            const duplicate = state.customers.find(c => c.id !== editId && (c.name.toLowerCase() === name.toLowerCase() || (phone && c.phone === phone)));
            if (duplicate) {
                showToast('A customer with this name or phone already exists!', 'error');
                return;
            }

            let customerId = editId;
            if (!customerId) {
                // Auto generate CUST-XXXX
                const nextNum = state.customers.length + 1001;
                customerId = `CUST-${nextNum}`;
            }

            const customerObj = {
                id: customerId,
                name: name,
                phone: phone || '',
                createdAt: editId ? (state.customers.find(c => c.id === editId)?.createdAt || new Date().toISOString()) : new Date().toISOString()
            };

            await dbPut('customers', customerObj);
            await reloadAllData();
            closeModal('customerModal');
            showToast(`Customer saved: ${name}`);

            if (fromOrder) {
                // If triggered inside New Order modal, update dropdown and select newly added customer
                populateCustomerSelect();
                document.getElementById('orderCustomerSelect').value = customerId;
            }
        }

        function renderCustomersList() {
            const search = document.getElementById('customerSearchInput').value.toLowerCase();
            const grid = document.getElementById('customersCardGrid');

            const filtered = state.customers.filter(c => 
                c.name.toLowerCase().includes(search) || 
                c.phone.includes(search) || 
                c.id.toLowerCase().includes(search)
            );

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-8 text-gray-400">No customers found.</div>`;
                return;
            }

            grid.innerHTML = filtered.map(c => {
                // Calculate customer stats dynamically
                const custOrders = state.orders.filter(o => o.customerId === c.id);
                const totalOrders = custOrders.length;
                let totalBill = 0;
                let totalPaid = 0;

                custOrders.forEach(o => {
                    const amt = Number(o.totalAmount || 0);
                    totalBill += amt;
                    if (o.paymentStatus === 'Paid') totalPaid += amt;
                });

                const remaining = totalBill - totalPaid;

                return `
                    <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-3">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-[10px] font-bold bg-canteen-100 text-canteen-800 px-2 py-0.5 rounded">${c.id}</span>
                                <h3 class="font-bold text-gray-800 text-lg mt-1">${escapeHtml(c.name)}</h3>
                                <p class="text-xs text-gray-500">${c.phone ? `<i class="fa-solid fa-phone text-[10px]"></i> ${escapeHtml(c.phone)}` : 'No phone'}</p>
                            </div>
                            <button onclick="openCustomerLedger('${c.id}')" class="bg-canteen-50 hover:bg-canteen-100 text-canteen-700 p-2 rounded-xl text-xs font-semibold flex items-center gap-1">
                                <i class="fa-solid fa-book-open"></i> Ledger
                            </button>
                        </div>

                        <div class="grid grid-cols-3 gap-2 bg-gray-50 p-2.5 rounded-xl text-center text-xs">
                            <div>
                                <div class="text-[10px] text-gray-400 font-medium">Orders</div>
                                <div class="font-bold text-gray-700">${totalOrders}</div>
                            </div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-medium">Total Bill</div>
                                <div class="font-bold text-gray-700">Rs.${totalBill}</div>
                            </div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-medium">Udhar Due</div>
                                <div class="font-bold ${remaining > 0 ? 'text-red-600' : 'text-emerald-600'}">Rs.${remaining}</div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function openCustomerLedger(customerId) {
            const customer = state.customers.find(c => c.id === customerId);
            if (!customer) return;

            const custOrders = state.orders.filter(o => o.customerId === customerId);
            let totalBill = 0;
            let totalPaid = 0;

            custOrders.forEach(o => {
                const amt = Number(o.totalAmount || 0);
                totalBill += amt;
                if (o.paymentStatus === 'Paid') totalPaid += amt;
            });
            const remaining = totalBill - totalPaid;

            document.getElementById('accCustId').innerText = customer.id;
            document.getElementById('accCustName').innerText = customer.name;
            document.getElementById('accCustPhone').innerText = customer.phone ? `Phone: ${customer.phone}` : 'No phone specified';
            
            document.getElementById('accTotalOrders').innerText = custOrders.length;
            document.getElementById('accTotalBill').innerText = `Rs. ${totalBill.toLocaleString()}`;
            document.getElementById('accTotalPaid').innerText = `Rs. ${totalPaid.toLocaleString()}`;
            document.getElementById('accRemainingBalance').innerText = `Rs. ${remaining.toLocaleString()}`;

            const tbody = document.getElementById('accOrdersTable');
            if (custOrders.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-400">No transactions recorded for this customer.</td></tr>`;
            } else {
                tbody.innerHTML = custOrders.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt)).map(o => `
                    <tr class="hover:bg-gray-50">
                        <td class="p-2.5 text-gray-500">${new Date(o.createdAt).toLocaleDateString()}</td>
                        <td class="p-2.5 font-mono font-bold text-canteen-800">${o.id}</td>
                        <td class="p-2.5">${escapeHtml(o.productName)} (${o.size})</td>
                        <td class="p-2.5">${o.quantity}</td>
                        <td class="p-2.5 font-bold">Rs. ${o.totalAmount}</td>
                        <td class="p-2.5">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${o.paymentStatus === 'Paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
                                ${o.paymentStatus}
                            </span>
                        </td>
                    </tr>
                `).join('');
            }

            document.getElementById('customerAccountModal').classList.remove('hidden');
        }


        /* ================= 3. Order Management & Form Logic ================= */
        function showQuickNewOrderModal(editOrderId = null) {
            populateCustomerSelect();
            populateProductSelect();

            const form = document.getElementById('orderForm');
            form.reset();

            if (editOrderId) {
                const order = state.orders.find(o => o.id === editOrderId);
                if (!order) return;
                document.getElementById('orderModalTitle').innerText = `Edit Order ${order.id}`;
                document.getElementById('orderEditId').value = order.id;
                document.getElementById('orderCustomerSelect').value = order.customerId;
                document.getElementById('orderProductSelect').value = order.productId;
                onOrderProductChange();
                document.getElementById('orderSizeSelect').value = order.size;
                document.getElementById('orderQuantity').value = order.quantity;
                document.getElementById('orderUnitPrice').value = order.unitPrice;
                document.getElementById('orderPaymentStatus').value = order.paymentStatus;
                document.getElementById('orderDeliveryStatus').value = order.deliveryStatus;
                calculateOrderTotal();
            } else {
                document.getElementById('orderModalTitle').innerText = 'Create New Order';
                document.getElementById('orderEditId').value = '';
                onOrderProductChange();
            }

            document.getElementById('orderModal').classList.remove('hidden');
        }

        function populateCustomerSelect() {
            const select = document.getElementById('orderCustomerSelect');
            if (state.customers.length === 0) {
                select.innerHTML = `<option value="">-- No Customers. Add One! --</option>`;
                return;
            }
            select.innerHTML = state.customers.map(c => `
                <option value="${c.id}">${escapeHtml(c.name)} (${c.id})</option>
            `).join('');
        }

        function populateProductSelect() {
            const select = document.getElementById('orderProductSelect');
            select.innerHTML = state.products.map(p => `
                <option value="${p.id}">${escapeHtml(p.name)}</option>
            `).join('');
        }

        function onOrderProductChange() {
            const productId = document.getElementById('orderProductSelect').value;
            const product = state.products.find(p => p.id === productId);
            const sizeSelect = document.getElementById('orderSizeSelect');

            if (!product || !product.sizes) {
                sizeSelect.innerHTML = `<option value="Regular">Regular</option>`;
                document.getElementById('orderUnitPrice').value = 0;
            } else {
                const sizes = Object.keys(product.sizes);
                sizeSelect.innerHTML = sizes.map(s => `<option value="${s}">${s} (Rs. ${product.sizes[s]})</option>`).join('');
                
                // Set default unit price from product catalog
                const selectedSize = sizeSelect.value;
                document.getElementById('orderUnitPrice').value = product.sizes[selectedSize] || 0;
            }
            calculateOrderTotal();
        }

        function calculateOrderTotal() {
            const productId = document.getElementById('orderProductSelect').value;
            const product = state.products.find(p => p.id === productId);
            const size = document.getElementById('orderSizeSelect').value;
            
            // Auto update price input if changed size (unless user manually entered unit price)
            if (product && product.sizes && product.sizes[size] !== undefined && !document.getElementById('orderEditId').value) {
                document.getElementById('orderUnitPrice').value = product.sizes[size];
            }

            const qty = Number(document.getElementById('orderQuantity').value || 1);
            const unitPrice = Number(document.getElementById('orderUnitPrice').value || 0);
            
            const total = qty * unitPrice;
            document.getElementById('orderTotal').value = total;
        }

        function onOrderCustomerChange() {}

        async function saveOrder(e) {
            e.preventDefault();
            const editId = document.getElementById('orderEditId').value;
            const customerId = document.getElementById('orderCustomerSelect').value;
            const productId = document.getElementById('orderProductSelect').value;
            const size = document.getElementById('orderSizeSelect').value;
            const quantity = Number(document.getElementById('orderQuantity').value);
            const unitPrice = Number(document.getElementById('orderUnitPrice').value);
            const totalAmount = Number(document.getElementById('orderTotal').value);
            const paymentStatus = document.getElementById('orderPaymentStatus').value;
            const deliveryStatus = document.getElementById('orderDeliveryStatus').value;

            if (!customerId) {
                showToast('Please select or add a customer.', 'error');
                return;
            }

            const customer = state.customers.find(c => c.id === customerId);
            const product = state.products.find(p => p.id === productId);

            let orderId = editId;
            if (!orderId) {
                const nextNum = state.orders.length + 5001;
                orderId = `ORD-${nextNum}`;
            }

            const existingOrder = state.orders.find(o => o.id === editId);

            const orderObj = {
                id: orderId,
                customerId: customerId,
                customerName: customer ? customer.name : 'Unknown',
                productId: productId,
                productName: product ? product.name : 'Custom Item',
                size: size,
                quantity: quantity,
                unitPrice: unitPrice,
                totalAmount: totalAmount,
                paymentStatus: paymentStatus,
                deliveryStatus: deliveryStatus,
                date: existingOrder ? existingOrder.date : new Date().toISOString().split('T')[0],
                createdAt: existingOrder ? existingOrder.createdAt : new Date().toISOString()
            };

            await dbPut('orders', orderObj);
            await reloadAllData();
            closeModal('orderModal');
            showToast(`Order ${orderId} saved successfully.`);
        }

        /* ================= 4. Order History View & Filter ================= */
        function renderOrdersTable() {
            const search = document.getElementById('orderSearchInput').value.toLowerCase();
            const payFilter = document.getElementById('orderPaymentFilter').value;
            const delFilter = document.getElementById('orderDeliveryFilter').value;
            const dateFilter = document.getElementById('orderDateFilter').value;

            const tbody = document.getElementById('ordersFullTable');

            const filtered = state.orders.filter(o => {
                const matchesSearch = o.customerName.toLowerCase().includes(search) || o.id.toLowerCase().includes(search);
                const matchesPay = payFilter === 'ALL' || o.paymentStatus === payFilter;
                const matchesDel = delFilter === 'ALL' || o.deliveryStatus === delFilter;
                const matchesDate = !dateFilter || (o.date && o.date.startsWith(dateFilter));
                return matchesSearch && matchesPay && matchesDel && matchesDate;
            });

            // Sort newest first
            filtered.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-6 text-center text-gray-400">No matching orders found.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(o => `
                <tr class="hover:bg-gray-50/70 border-b border-gray-100">
                    <td class="py-3 px-4 text-xs text-gray-500">${new Date(o.createdAt).toLocaleString()}</td>
                    <td class="py-3 px-4 font-mono font-bold text-xs text-canteen-800">${o.id}</td>
                    <td class="py-3 px-4 font-semibold text-gray-800">${escapeHtml(o.customerName)}</td>
                    <td class="py-3 px-4">${escapeHtml(o.productName)} (${o.size})</td>
                    <td class="py-3 px-4 text-gray-600">${o.quantity} × Rs.${o.unitPrice}</td>
                    <td class="py-3 px-4 font-bold text-gray-900">Rs.${o.totalAmount}</td>
                    <td class="py-3 px-4">
                        <span class="px-2.5 py-1 text-[10px] font-bold rounded-full ${o.paymentStatus === 'Paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
                            ${o.paymentStatus}
                        </span>
                    </td>
                    <td class="py-3 px-4">
                        <span class="px-2.5 py-1 text-[10px] font-bold rounded-full ${o.deliveryStatus === 'Delivered' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-700'}">
                            ${o.deliveryStatus}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-center">
                        <div class="flex justify-center gap-1">
                            <button onclick="showQuickNewOrderModal('${o.id}')" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg" title="Edit Order">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="deleteOrderPrompt('${o.id}')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg" title="Delete Order">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        async function deleteOrderPrompt(orderId) {
            if (confirm(`Are you sure you want to delete order ${orderId}?`)) {
                await dbDelete('orders', orderId);
                await reloadAllData();
                showToast(`Order ${orderId} deleted.`);
            }
        }

        /* ================= 5. Products Setup & Catalog ================= */
        function openAddProductModal(editProductId = null) {
            const form = document.getElementById('productForm');
            form.reset();

            if (editProductId) {
                const product = state.products.find(p => p.id === editProductId);
                if (!product) return;
                document.getElementById('productModalTitle').innerText = 'Edit Product';
                document.getElementById('productEditId').value = product.id;
                document.getElementById('productName').value = product.name;
                document.getElementById('productMediumPrice').value = product.sizes?.Medium || '';
                document.getElementById('productLargePrice').value = product.sizes?.Large || '';
            } else {
                document.getElementById('productModalTitle').innerText = 'Add New Product';
                document.getElementById('productEditId').value = '';
            }

            document.getElementById('productModal').classList.remove('hidden');
        }

        async function saveProduct(e) {
            e.preventDefault();
            const editId = document.getElementById('productEditId').value;
            const name = document.getElementById('productName').value.trim();
            const medPrice = Number(document.getElementById('productMediumPrice').value || 0);
            const lrgPrice = Number(document.getElementById('productLargePrice').value || 0);

            if (!name) return;

            let prodId = editId;
            if (!prodId) {
                prodId = `PROD-${Date.now()}`;
            }

            const sizesObj = {};
            if (medPrice > 0) sizesObj['Medium'] = medPrice;
            if (lrgPrice > 0) sizesObj['Large'] = lrgPrice;
            if (Object.keys(sizesObj).length === 0) {
                sizesObj['Regular'] = 100;
            }

            const productObj = {
                id: prodId,
                name: name,
                sizes: sizesObj
            };

            await dbPut('products', productObj);
            await reloadAllData();
            closeModal('productModal');
            showToast(`Product saved: ${name}`);
        }

        function renderProductsGrid() {
            const grid = document.getElementById('productsGrid');

            grid.innerHTML = state.products.map(p => `
                <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex justify-between items-start">
                            <h3 class="font-bold text-gray-800 text-lg">${escapeHtml(p.name)}</h3>
                            <button onclick="openAddProductModal('${p.id}')" class="text-xs text-canteen-700 hover:underline">
                                <i class="fa-solid fa-pen"></i> Edit
                            </button>
                        </div>
                        <div class="mt-3 space-y-1">
                            ${Object.entries(p.sizes || {}).map(([size, price]) => `
                                <div class="flex justify-between text-xs bg-gray-50 px-2.5 py-1.5 rounded-lg">
                                    <span class="text-gray-600 font-medium">${size}</span>
                                    <span class="font-bold text-canteen-800">Rs. ${price}</span>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <button onclick="deleteProductPrompt('${p.id}')" class="w-full text-xs text-red-500 hover:text-red-700 py-1 font-semibold text-center border border-red-100 rounded-lg hover:bg-red-50">
                        Remove Product
                    </button>
                </div>
            `).join('');
        }

        async function deleteProductPrompt(productId) {
            if (confirm('Delete this product from catalog? Existing orders will retain their saved price.')) {
                await dbDelete('products', productId);
                await reloadAllData();
                showToast('Product removed.');
            }
        }

        /* ================= 6. Backup & Restore ================= */
        function exportJSONBackup() {
            const backupData = {
                version: 1,
                exportedAt: new Date().toISOString(),
                customers: state.customers,
                products: state.products,
                orders: state.orders
            };

            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `CanteenKhata_Backup_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast('JSON Backup downloaded.');
        }

        function exportOrdersCSV() {
            if (state.orders.length === 0) {
                showToast('No orders available to export.', 'error');
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Order ID,Date,Customer,Product,Size,Quantity,Unit Price,Total Amount,Payment Status,Delivery Status\n";

            state.orders.forEach(o => {
                const row = [
                    o.id,
                    o.date || '',
                    `"${o.customerName}"`,
                    `"${o.productName}"`,
                    o.size,
                    o.quantity,
                    o.unitPrice,
                    o.totalAmount,
                    o.paymentStatus,
                    o.deliveryStatus
                ].join(",");
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Canteen_Orders_Report_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            link.remove();
            showToast('Orders exported to CSV.');
        }

        async function handleRestoreFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (!data.customers || !data.orders || !data.products) {
                        throw new Error('Invalid JSON schema');
                    }

                    // Restore Products
                    for (const p of data.products) {
                        await dbPut('products', p);
                    }
                    // Restore Customers
                    for (const c of data.customers) {
                        await dbPut('customers', c);
                    }
                    // Restore Orders
                    for (const o of data.orders) {
                        await dbPut('orders', o);
                    }

                    await reloadAllData();
                    showToast('Backup restored successfully!');
                } catch (err) {
                    showToast('Failed to restore backup file.', 'error');
                    console.error(err);
                }
            };
            reader.readAsText(file);
        }

        /* ================= UI Utilities & Helpers ================= */
        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `px-4 py-2.5 rounded-xl shadow-lg text-sm font-semibold pointer-events-auto flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0 ${
                type === 'error' ? 'bg-red-800 text-white' : 'bg-canteen-800 text-white'
            }`;
            toast.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i> ${escapeHtml(message)}`;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
            })[m]);
        }

        /* ================= Progressive Web App (PWA) Handler ================= */
        let deferredPrompt;

        function setupPWA() {
            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                const pwaBtn = document.getElementById('pwaInstallBtn');
                if (pwaBtn) pwaBtn.classList.remove('hidden');
            });
        }

        function installPWA() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') {
                        document.getElementById('pwaInstallBtn').classList.add('hidden');
                    }
                    deferredPrompt = null;
                });
            }
        }
    </script>
