<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canteen Khata - Offline Ledger & Order App</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        canteen: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                            dark: '#1b5e20'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #f4f7f5;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #16a34a;
            border-radius: 3px;
        }
        .tab-btn.active {
            background-color: #15803d;
            color: #ffffff;
        }
        .tab-btn-mobile.active {
            color: #15803d;
            font-weight: bold;
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
        }
    </style>
</head>
<body class="text-gray-800 antialiased flex flex-col min-h-screen pb-16 md:pb-0">

    <!-- TOP HEADER -->
    <header class="bg-canteen-800 text-white shadow-md sticky top-0 z-30 no-print">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-white text-canteen-800 p-2 rounded-lg font-black text-xl shadow">
                    <i class="fa-solid fa-utensils"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide leading-none">Canteen Khata</h1>
                    <span class="text-xs text-canteen-100 opacity-90">Digital Offline Ledger & Billing</span>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <button id="pwaInstallBtn" onclick="installPWA()" class="hidden bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-semibold px-3 py-1.5 rounded-lg text-xs md:text-sm shadow flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-download"></i> <span class="hidden sm:inline">Install App</span>
                </button>
                <button onclick="showQuickNewOrderModal()" class="bg-canteen-500 hover:bg-canteen-600 text-white px-3 py-1.5 rounded-lg text-xs md:text-sm font-semibold shadow flex items-center gap-1 transition">
                    <i class="fa-solid fa-plus-circle"></i> <span>New Order</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN BODY CONTAINER WITH NAVIGATION -->
    <div class="flex-1 max-w-7xl w-full mx-auto flex flex-col md:flex-row">
        
        <!-- SIDEBAR NAVIGATION (Desktop) -->
        <aside class="w-full md:w-64 bg-white border-r border-gray-200 p-4 hidden md:block no-print">
            <nav class="space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="tab-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-canteen-50 transition active">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i> Dashboard
                </button>
                <button onclick="switchTab('orders')" id="nav-orders" class="tab-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-canteen-50 transition">
                    <i class="fa-solid fa-receipt w-5 text-center"></i> Order History
                </button>
                <button onclick="switchTab('customers')" id="nav-customers" class="tab-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-canteen-50 transition">
                    <i class="fa-solid fa-users w-5 text-center"></i> Customers & Khata
                </button>
                <button onclick="switchTab('products')" id="nav-products" class="tab-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-canteen-50 transition">
                    <i class="fa-solid fa-burger w-5 text-center"></i> Products & Menu
                </button>
                <button onclick="switchTab('backup')" id="nav-backup" class="tab-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-canteen-50 transition">
                    <i class="fa-solid fa-database w-5 text-center"></i> Backup & Restore
                </button>
            </nav>

            <div class="mt-8 p-3 bg-canteen-50 rounded-xl border border-canteen-100 text-xs text-canteen-800">
                <div class="font-bold mb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-shield-halved text-canteen-600"></i> Local Storage Active
                </div>
                <p>Data is stored inside your browser's IndexedDB. Works 100% offline.</p>
            </div>
        </aside>

        <!-- CONTENT VIEWS AREA -->
        <main class="flex-1 p-4 md:p-6 overflow-x-hidden">

            <!-- ALERTS / NOTIFICATION CONTAINER -->
            <div id="toastContainer" class="fixed top-16 right-4 z-50 space-y-2 pointer-events-none"></div>

            <!-- TAB 1: DASHBOARD -->
            <section id="tab-dashboard-view" class="space-y-6">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">Dashboard Summary</h2>
                        <p class="text-sm text-gray-500" id="currentDateDisplay">Today's Overview</p>
                    </div>
                    <button onclick="loadDashboardData()" class="text-canteen-700 hover:text-canteen-900 text-sm font-medium flex items-center gap-1">
                        <i class="fa-solid fa-rotate"></i> Refresh
                    </button>
                </div>

                <!-- METRICS GRID -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
                    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Today Sales</span>
                        <div class="text-xl md:text-2xl font-black text-canteen-700 mt-2" id="dashTodaySales">Rs. 0</div>
                        <span class="text-[10px] text-gray-400 mt-1">Paid + Unpaid</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Orders</span>
                        <div class="text-xl md:text-2xl font-black text-gray-800 mt-2" id="dashTotalOrders">0</div>
                        <span class="text-[10px] text-gray-400 mt-1">All time</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Customers</span>
                        <div class="text-xl md:text-2xl font-black text-blue-600 mt-2" id="dashTotalCustomers">0</div>
                        <span class="text-[10px] text-gray-400 mt-1">Registered</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Paid</span>
                        <div class="text-xl md:text-2xl font-black text-emerald-600 mt-2" id="dashTotalPaid">Rs. 0</div>
                        <span class="text-[10px] text-gray-400 mt-1">Collected Revenue</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Unpaid</span>
                        <div class="text-xl md:text-2xl font-black text-amber-600 mt-2" id="dashTotalUnpaid">Rs. 0</div>
                        <span class="text-[10px] text-gray-400 mt-1">Pending Collections</span>
                    </div>
                    <div class="bg-white p-4 border-2 border-red-200 bg-red-50/50 rounded-xl shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-bold text-red-600 uppercase tracking-wider">Khata Balance</span>
                        <div class="text-xl md:text-2xl font-black text-red-700 mt-2" id="dashRemainingBalance">Rs. 0</div>
                        <span class="text-[10px] text-red-500 font-medium mt-1">Total Udhar / Due</span>
                    </div>
                </div>

                <!-- RECENT ORDERS SECTION -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 md:p-5">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-canteen-600"></i> Recent Orders
                        </h3>
                        <button onclick="switchTab('orders')" class="text-xs font-semibold text-canteen-700 hover:underline">
                            View All Orders &rarr;
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="border-b border-gray-200 bg-gray-50 text-gray-500 font-medium text-xs">
                                    <th class="py-2.5 px-3">Order ID</th>
                                    <th class="py-2.5 px-3">Customer</th>
                                    <th class="py-2.5 px-3">Items</th>
                                    <th class="py-2.5 px-3">Amount</th>
                                    <th class="py-2.5 px-3">Payment</th>
                                    <th class="py-2.5 px-3">Delivery</th>
                                    <th class="py-2.5 px-3 text-right">Quick Action</th>
                                </tr>
                            </thead>
                            <tbody id="dashRecentOrdersTable" class="divide-y divide-gray-100 text-gray-700">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 2: ORDER HISTORY -->
            <section id="tab-orders-view" class="space-y-4 hidden">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">Order Management & History</h2>
                        <p class="text-sm text-gray-500">Filter, edit and inspect all canteen orders</p>
                    </div>
                    <button onclick="showQuickNewOrderModal()" class="bg-canteen-700 hover:bg-canteen-800 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow flex items-center gap-2">
                        <i class="fa-solid fa-cart-plus"></i> Create New Order
                    </button>
                </div>

                <!-- FILTERS TOOLBAR -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 grid grid-cols-1 sm:grid-cols-4 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Search Customer / ID</label>
                        <input type="text" id="orderSearchInput" oninput="renderOrdersTable()" placeholder="Name or Order ID..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-canteen-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Payment Status</label>
                        <select id="orderPaymentFilter" onchange="renderOrdersTable()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-canteen-500">
                            <option value="ALL">All Payment Statuses</option>
                            <option value="Paid">Paid</option>
                            <option value="Unpaid">Unpaid</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Delivery Status</label>
                        <select id="orderDeliveryFilter" onchange="renderOrdersTable()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-canteen-500">
                            <option value="ALL">All Delivery Statuses</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Date Filter</label>
                        <input type="date" id="orderDateFilter" onchange="renderOrdersTable()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-canteen-500">
                    </div>
                </div>

                <!-- ORDERS TABLE CONTAINER -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200 text-gray-500 font-semibold text-xs">
                                    <th class="py-3 px-4">Date & Time</th>
                                    <th class="py-3 px-4">Order ID</th>
                                    <th class="py-3 px-4">Customer</th>
                                    <th class="py-3 px-4">Product & Size</th>
                                    <th class="py-3 px-4">Qty × Price</th>
                                    <th class="py-3 px-4">Total</th>
                                    <th class="py-3 px-4">Payment</th>
                                    <th class="py-3 px-4">Delivery</th>
                                    <th class="py-3 px-4 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ordersFullTable" class="divide-y divide-gray-100">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 3: CUSTOMER MANAGEMENT & ACCOUNT LEDGER -->
            <section id="tab-customers-view" class="space-y-4 hidden">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">Customer Management & Ledger</h2>
                        <p class="text-sm text-gray-500">Manage customers and track account balances (Udhar Khata)</p>
                    </div>
                    <button onclick="openAddCustomerModal()" class="bg-canteen-700 hover:bg-canteen-800 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow flex items-center gap-2">
                        <i class="fa-solid fa-user-plus"></i> Add New Customer
                    </button>
                </div>

                <!-- SEARCH & FILTER -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-col sm:flex-row gap-3">
                    <div class="flex-1">
                        <input type="text" id="customerSearchInput" oninput="renderCustomersList()" placeholder="Search by Customer Name, Phone, or ID..." class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-canteen-500">
                    </div>
                </div>

                <!-- CUSTOMERS GRID -->
                <div id="customersCardGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Cards rendered dynamically -->
                </div>
            </section>

            <!-- TAB 4: PRODUCTS CATALOG MANAGEMENT -->
            <section id="tab-products-view" class="space-y-4 hidden">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">Products & Menu Setup</h2>
                        <p class="text-sm text-gray-500">Configure canteen menu items, sizes, and default prices</p>
                    </div>
                    <button onclick="openAddProductModal()" class="bg-canteen-700 hover:bg-canteen-800 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow flex items-center gap-2">
                        <i class="fa-solid fa-mug-hot"></i> Add New Product
                    </button>
                </div>

                <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Product Cards dynamic -->
                </div>
            </section>

            <!-- TAB 5: BACKUP & RESTORE -->
            <section id="tab-backup-view" class="space-y-6 hidden">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">Data Backup & Export</h2>
                    <p class="text-sm text-gray-500">Safeguard your canteen database, restore backups, or export reports</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- EXPORT BOX -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="p-3 bg-canteen-100 text-canteen-800 rounded-xl">
                                <i class="fa-solid fa-file-export text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-800 text-lg">Export Options</h3>
                                <p class="text-xs text-gray-500">Download complete data or reports</p>
                            </div>
                        </div>
                        <p class="text-sm text-gray-600">Generate an offline backup file containing all customers, product menus, and transaction history.</p>
                        
                        <div class="space-y-2 pt-2">
                            <button onclick="exportJSONBackup()" class="w-full py-2.5 px-4 bg-canteen-700 hover:bg-canteen-800 text-white text-sm font-semibold rounded-xl shadow transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-download"></i> Export Full JSON Database Backup
                            </button>
                            <button onclick="exportOrdersCSV()" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl shadow transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-file-csv"></i> Export Orders to CSV Excel Report
                            </button>
                        </div>
                    </div>

                    <!-- RESTORE BOX -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="p-3 bg-amber-100 text-amber-800 rounded-xl">
                                <i class="fa-solid fa-file-import text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-800 text-lg">Restore JSON Database</h3>
                                <p class="text-xs text-gray-500">Import saved JSON backup file</p>
                            </div>
                        </div>
                        <p class="text-sm text-gray-600">Select a previously exported JSON backup file to merge or restore data into IndexedDB.</p>
                        
                        <div class="border-2 border-dashed border-gray-300 rounded-xl p-4 text-center hover:bg-gray-50 transition">
                            <input type="file" id="restoreFileInput" accept=".json" class="hidden" onchange="handleRestoreFile(event)">
                            <label for="restoreFileInput" class="cursor-pointer block">
                                <i class="fa-solid fa-cloud-arrow-up text-2xl text-gray-400 mb-1"></i>
                                <span class="block text-xs font-semibold text-canteen-700">Click to Select JSON File</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- MOBILE BOTTOM TAB BAR -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 flex justify-around items-center py-2 z-30 no-print">
        <button onclick="switchTab('dashboard')" id="mobile-nav-dashboard" class="tab-btn-mobile flex flex-col items-center text-xs text-gray-500 active">
            <i class="fa-solid fa-chart-pie text-lg mb-0.5"></i> Home
        </button>
        <button onclick="switchTab('orders')" id="mobile-nav-orders" class="tab-btn-mobile flex flex-col items-center text-xs text-gray-500">
            <i class="fa-solid fa-receipt text-lg mb-0.5"></i> Orders
        </button>
        <button onclick="switchTab('customers')" id="mobile-nav-customers" class="tab-btn-mobile flex flex-col items-center text-xs text-gray-500">
            <i class="fa-solid fa-users text-lg mb-0.5"></i> Khata
        </button>
        <button onclick="switchTab('products')" id="mobile-nav-products" class="tab-btn-mobile flex flex-col items-center text-xs text-gray-500">
            <i class="fa-solid fa-burger text-lg mb-0.5"></i> Menu
        </button>
    </nav>

    <!-- MODAL: NEW / EDIT ORDER -->
    <div id="orderModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal('orderModal')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-xl font-bold text-gray-800 mb-4" id="orderModalTitle">Create New Order</h3>
            
            <form id="orderForm" onsubmit="saveOrder(event)" class="space-y-4">
                <input type="hidden" id="orderEditId">
                
                <!-- CUSTOMER SELECTOR OR NEW ENTRY -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Customer *</label>
                    <div class="flex gap-2">
                        <select id="orderCustomerSelect" required onchange="onOrderCustomerChange()" class="flex-1 px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-canteen-500">
                            <!-- Populated dynamically -->
                        </select>
                        <button type="button" onclick="openAddCustomerModal(true)" class="bg-canteen-100 text-canteen-800 px-3 py-2 rounded-xl text-sm font-semibold hover:bg-canteen-200">
                            + New
                        </button>
                    </div>
                </div>

                <!-- PRODUCT SELECTOR -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Product Item *</label>
                    <select id="orderProductSelect" required onchange="onOrderProductChange()" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-canteen-500">
                        <!-- Populated dynamically -->
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <!-- SIZE SELECTOR -->
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Size / Option *</label>
                        <select id="orderSizeSelect" required onchange="calculateOrderTotal()" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-canteen-500">
                            <!-- Populated dynamically -->
                        </select>
                    </div>

                    <!-- QUANTITY -->
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Quantity *</label>
                        <input type="number" id="orderQuantity" min="1" value="1" required oninput="calculateOrderTotal()" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-canteen-500">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <!-- UNIT PRICE (AUTO-CALCULATED BUT EDITABLE) -->
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Unit Price (Rs.) *</label>
                        <input type="number" id="orderUnitPrice" min="0" required oninput="calculateOrderTotal()" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-canteen-500">
                    </div>
                    <!-- TOTAL AMOUNT (CALCULATED) -->
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Total (Rs.)</label>
                        <input type="number" id="orderTotal" readonly class="w-full px-3 py-2 border border-gray-200 bg-gray-50 font-bold text-canteen-700 rounded-xl text-sm">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-2">
                    <!-- PAYMENT STATUS -->
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1 uppercase">Payment Status</label>
                        <select id="orderPaymentStatus" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-canteen-500 font-semibold">
